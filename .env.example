# Public — inlined into the client bundle at build time.
VITE_API_BASE_URL=https://partner-api.dev.docpharma.in

# Server-side only. Used by `npm run generate:media` (scripts/generate-media.mjs).
# NEVER prefix this with VITE_ — that would inline the secret into public JS.
# Put the real value in .env.local, which is gitignored.
GEMINI_API_KEY=
